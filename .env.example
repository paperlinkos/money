# The API does not connect to the database yet. This is the future shared
# connection value for the PostgreSQL instance on your VPS.
DATABASE_URL=postgresql://platform:change-me@localhost:5432/platform
SESSION_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:5173

# Optional production settings: keep the API private behind nginx, store uploads
# outside the app folder, and pause uploads below this many free disk bytes.
# HOST=127.0.0.1
# PROOF_UPLOAD_DIR=/var/lib/paperlinkos/uploads
# PROOF_MIN_FREE_BYTES=3221225472

# API port used by the frontend proxy in development.
PORT=3001

# Optional public contact channel for the feedback/contact pages. This must be
# a complete, intentionally configured URL (for example, a mailto: link or
# contact form URL). Leave blank to offer copy-to-clipboard feedback only.
VITE_FEEDBACK_CONTACT_URL=

# Public website origin used for canonical URLs, Open Graph URLs, robots, and
# sitemap generation. This is public configuration, not a secret.
VITE_SITE_URL=http://localhost:5173

# Paystack billing (API only, never VITE_*). Create two monthly plans in the
# Paystack dashboard (Pro ₦5,000 and Studio ₦12,000) and paste their plan codes.
# Set the webhook URL to https://<your-domain>/api/billing/webhook.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_STUDIO=
